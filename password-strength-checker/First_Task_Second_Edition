#include <stdio.h>
#include <string.h>
#include <ctype.h>

void evaluate_password(const char *pwd) {
    int length = strlen(pwd);
    int has_upper = 0, has_lower = 0, has_digit = 0, has_symbol = 0;

    for (int i = 0; i < length; i++) {
        if (isupper(pwd[i])) {
            has_upper = 1;
        } else if (islower(pwd[i])) {
            has_lower = 1;
        } else if (isdigit(pwd[i])) {
            has_digit = 1;
        } else if (ispunct(pwd[i])) {
            has_symbol = 1;
        }
    }

    printf("\n========================================\n");
    printf("         PASSWORD STRENGTH REPORT       \n");
    printf("========================================\n");
    printf("Password Length: %d characters %s\n", length, (length >= 8) ? "[PASS]" : "[FAIL]");
    printf("- Uppercase letter (A-Z): %s\n", has_upper ? "Found (✓)" : "Missing (✗)");
    printf("- Lowercase letter (a-z): %s\n", has_lower ? "Found (✓)" : "Missing (✗)");
    printf("- Numeric digit (0-9):    %s\n", has_digit ? "Found (✓)" : "Missing (✗)");
    printf("- Special symbol/punct:   %s\n", has_symbol ? "Found (✓)" : "Missing (✗)");
    printf("----------------------------------------\n");

    if (length < 8) {
        printf("[Error] Password is too short! Must be at least 8 characters.\n");
    }
    if (!has_upper) {
        printf("[Tip] Add at least one uppercase letter (A-Z).\n");
    }
    if (!has_lower) {
        printf("[Tip] Add at least one lowercase letter (a-z).\n");
    }
    if (!has_digit) {
        printf("[Tip] Add at least one number (0-9).\n");
    }
    if (!has_symbol) {
        printf("[Tip] Add at least one special character (!, @, #, etc.).\n");
    }

    int score = has_upper + has_lower + has_digit + has_symbol;

    printf("\nFinal Security Status: ");
    if (length < 8) {
        printf("WEAK (Rejected: fails minimum length)\n");
    } else if (score == 4) {
        printf("STRONG (Meets all criteria!)\n");
    } else if (score >= 2) {
        printf("ACCEPTABLE (Decent, but could be stronger)\n");
    } else {
        printf("WEAK (Too simple, easily compromised)\n");
    }
    printf("========================================\n");
}

int main() {
    char input[100];
    
    printf("Enter your password to evaluate: ");
    
    // Read input safely while preventing buffer overflow
    if (scanf("%99s", input) == 1) {
        evaluate_password(input);
    } else {
        printf("[Error] Failed to read input safely.\n");
    }
    
    return 0;
}
